PORT=3001
NODE_ENV=development
JWT_SECRET=change-me-in-production
DATABASE_URL=file:./data/qr-jidelnicek.sqlite
PUBLIC_BASE_URL=http://localhost:3001

# CORS allowlist — comma-separated origins. Empty in production blocks cross-origin
# requests; set to your frontend URL(s) for SaaS deploys with separate domains.
# Example: CORS_ORIGINS=https://qr-jidelnicek.cz,https://admin.qr-jidelnicek.cz
# Use "*" to allow any origin (only for development).
CORS_ORIGINS=

# Stripe (volitelné — bez nich /api/billing a /api/stripe vrací 503)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Resend (volitelné — bez něj se transakční e-maily nevypouštějí)
RESEND_API_KEY=
EMAIL_FROM="QR Jídelníček <noreply@example.com>"

# Disable rate-limiting on /api/auth/* (testing only — never set this in production)
# DISABLE_RATE_LIMIT=1
